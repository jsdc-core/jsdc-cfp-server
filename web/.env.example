# Frontend dev server port. Matches the backend's CLIENT_URL / CORS origin.
VITE_PORT=3000

# Backend API base URL.
# The backend runs on PORT=4000 with the `api/v1` global prefix (see ../.env).
# In dev, vite.config.ts also proxies "/api" -> http://localhost:4000, so you
# can alternatively set this to "/api/v1" to go through the same origin.
VITE_API_BASE_URL=http://localhost:4000/api/v1
